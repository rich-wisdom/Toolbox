<Page
    x:Class="WindowsToolbox.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="40" Spacing="30">
            <TextBlock Text="Windows Toolbox"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            
            <TextBlock Text="102 professional tools for Windows"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Opacity="0.7"/>

            <InfoBar Title="Quick Launcher"
                     Message="Press Ctrl+Alt+Space anywhere to open the quick launcher and search for tools"
                     Severity="Informational"
                     IsOpen="True"
                     IsClosable="False"/>

            <TextBlock Text="Categories"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,20,0,0"/>

            <GridView x:Name="CategoriesGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="CategoriesGrid_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="180" 
                              Height="120" 
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="8"
                              Padding="15">
                            <StackPanel VerticalAlignment="Center" Spacing="10">
                                <FontIcon Glyph="&#xE8B7;" FontSize="32"/>
                                <TextBlock Text="{Binding Name}" 
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ToolCount, StringFormat='{}{0} tools'}"
                                           Opacity="0.7"
                                           FontSize="12"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
