<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WindowsToolbox.Tools</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsToolbox.Core\WindowsToolbox.Core.csproj" />
  </ItemGroup>

  <!--
    These merged candidate implementations currently contain unresolved API and
    platform integration errors. Keep the source for follow-up work, but do not
    compile or advertise it until its category passes the Windows build.
  -->
  <ItemGroup>
    <Compile Remove="Audio\**\*.cs" />
    <Compile Remove="Document\**\*.cs" />
    <Compile Remove="Image\**\*.cs" />
    <Compile Remove="TextAndSpeech\**\*.cs" />
    <Compile Remove="Video\**\*.cs" />
  </ItemGroup>
</Project>
